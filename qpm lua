local function isCharacter(object)
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Character and object:IsDescendantOf(player.Character) then
            return true
        end
    end
    return false
end

local function isEffectObject(obj)
    return obj:IsA("ParticleEmitter") 
        or obj:IsA("Trail") 
        or obj:IsA("Smoke") 
        or obj:IsA("Fire") 
        or obj:IsA("Sparkles") 
        or obj:IsA("Beam") 
        or obj:IsA("Highlight") 
        or obj:IsA("Light")
end

local function handleNewObject(obj)
    if not autoRemoveEffects then return end
    if isEffectObject(obj) and not isCharacter(obj) then
        task.defer(function()
            if obj and obj.Parent and not isCharacter(obj) then
                obj:Destroy()
            end
        end)
    end
end

local function removeWorldTextures()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if not isCharacter(obj) then
            if obj:IsA("Texture") or obj:IsA("Decal") then
                obj:Destroy()
            elseif obj:IsA("BasePart") then
                obj.Material = Enum.Material.SmoothPlastic
            elseif obj:IsA("SpecialMesh") then
                obj.TextureId = ""
            end
        end
    end
end

local function toggleAutoRemoveEffects()
    autoRemoveEffects = not autoRemoveEffects
    if autoRemoveEffects then
        autoEffectButton.Text = "Auto Remove Effects: [ ON ]"
        autoEffectButton.BackgroundColor3 = Color3.fromRGB(50, 180, 80)
        for _, obj in ipairs(workspace:GetDescendants()) do
            if isEffectObject(obj) and not isCharacter(obj) then
                obj:Destroy()
            end
        end
        autoRemoveConnection = workspace.DescendantAdded:Connect(handleNewObject)
    else
        autoEffectButton.Text = "Auto Remove Effects: [ OFF ]"
        autoEffectButton.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
        if autoRemoveConnection then
            autoRemoveConnection:Disconnect()
            autoRemoveConnection = nil
        end
    end
end

local function applyHighlightAndName(player)
    if not player or player == localPlayer then return end
    local char = player.Character
    if not char then return end

    local head = char:WaitForChild("Head", 5)
    if not head then return end

    if not char:FindFirstChild("PlayerBlueHighlightESP") then
        local highlight = Instance.new("Highlight")
        highlight.Name = "PlayerBlueHighlightESP"
        highlight.FillColor = Color3.fromRGB(0, 170, 255)
        highlight.FillTransparency = 0.4
        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        highlight.OutlineTransparency = 0
        highlight.Adornee = char
        highlight.Parent = char
    end

    if not head:FindFirstChild("PlayerNameTagESP") then
        local billboard = Instance.new("BillboardGui")
        billboard.Name = "PlayerNameTagESP"
        billboard.Adornee = head
        billboard.Size = UDim2.new(0, 150, 0, 30)
        billboard.StudsOffset = Vector3.new(0, 2.5, 0)
        billboard.AlwaysOnTop = true
        billboard.Parent = head

        local nameLabel = Instance.new("TextLabel")
        nameLabel.Size = UDim2.new(1, 0, 1, 0)
        nameLabel.BackgroundTransparency = 1
        nameLabel.Text = player.DisplayName .. " (@" .. player.Name .. ")"
        nameLabel.TextColor3 = Color3.fromRGB(0, 220, 255)
        nameLabel.TextStrokeTransparency = 0.2
        nameLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        nameLabel.TextSize = 13
        nameLabel.Font = Enum.Font.SourceSansBold
        nameLabel.Parent = billboard
    end
end

local function removeHighlightAndName(player)
    if not player then return end
    local char = player.Character
    if not char then return end

    local hl = char:FindFirstChild("PlayerBlueHighlightESP")
    if hl then hl:Destroy() end

    local head = char:FindFirstChild("Head")
    if head then
        local tag = head:FindFirstChild("PlayerNameTagESP")
        if tag then tag:Destroy() end
    end
end

local function setupPlayerESP(player)
    if player == localPlayer then return end
    if player.Character then
        applyHighlightAndName(player)
    end
    local charConn = player.CharacterAdded:Connect(function(char)
        if espEnabled then
            char:WaitForChild("HumanoidRootPart", 5)
            applyHighlightAndName(player)
        end
    end)
    table.insert(espConnections, charConn)
end

local function togglePlayerESP()
    espEnabled = not espEnabled
    if espEnabled then
        espButton.Text = "Blue Highlight & Name ESP: [ ON ]"
        espButton.BackgroundColor3 = Color3.fromRGB(50, 180, 80)
        for _, player in ipairs(Players:GetPlayers()) do
            setupPlayerESP(player)
        end
        local playerAddedConn = Players.PlayerAdded:Connect(function(player)
            setupPlayerESP(player)
        end)
        table.insert(espConnections, playerAddedConn)
    else
        espButton.Text = "Blue Highlight & Name ESP: [ OFF ]"
        espButton.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
        for _, conn in ipairs(espConnections) do
            conn:Disconnect()
        end
        espConnections = {}
        for _, player in ipairs(Players:GetPlayers()) do
            removeHighlightAndName(player)
        end
    end
end

local function clearFogAndAtmosphere()
    for _, v in ipairs(Lighting:GetChildren()) do
        if v:IsA("PostEffect") or v:IsA("Atmosphere") or v:IsA("Clouds") then
            v:Destroy()
        end
    end
    Lighting.FogEnd = 100000
    Lighting.GlobalShadows = false
end

