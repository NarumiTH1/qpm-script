local function findRemote(targetStr)
    if targetStr == "" then return nil end
    
    -- เธฅเธญเธเธซเธฒเนเธ ReplicatedStorage / Workspace เธเนเธญเธเธ”เนเธงเธขเธเธทเนเธญ
    for _, obj in ipairs(game:GetDescendants()) do
        if (obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction")) and obj.Name == targetStr then
            return obj
        end
    end
    
    -- เธฅเธญเธเธญเนเธฒเธเนเธเธ Path (เธเธฃเธ“เธตเนเธชเนเน€เธเนเธ game.ReplicatedStorage...)
    local success, result = pcall(function()
        local pathParts = string.split(targetStr, ".")
        local current = game
        for _, part in ipairs(pathParts) do
            if part ~= "game" and current then
                current = current:FindFirstChild(part)
            end
        end
        return current
    end)
    
    if success and result and (result:IsA("RemoteEvent") or result:IsA("RemoteFunction")) then
        return result
    end
    
    return nil
end

local function parseArgs(argsStr)
    if argsStr == "" then return {} end
    local success, result = pcall(function()
        return loadstring("return {" .. argsStr .. "}")()
    end)
    if success and type(result) == "table" then
        return result
    end
    return {argsStr}
end

local function toggleRemoteLoop()
    remoteLoopEnabled = not remoteLoopEnabled
    
    if remoteLoopEnabled then
        local remoteInput = remoteNameBox.Text
        local targetRemote = findRemote(remoteInput)
        
        if not targetRemote then
            remoteLoopEnabled = false
            remoteLoopButton.Text = "Remote Not Found!"
            remoteLoopButton.BackgroundColor3 = Color3.fromRGB(220, 100, 0)
            task.delay(2, function()
                if not remoteLoopEnabled then
                    remoteLoopButton.Text = "Loop Remote: [ OFF ]"
                    remoteLoopButton.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
                end
            end)
            return
        end
        
        remoteLoopButton.Text = "Loop Remote: [ ON ]"
        remoteLoopButton.BackgroundColor3 = Color3.fromRGB(50, 180, 80)
        
        task.spawn(function()
            while remoteLoopEnabled do
                local args = parseArgs(remoteArgsBox.Text)
                pcall(function()
                    if targetRemote:IsA("RemoteEvent") then
                        targetRemote:FireServer(unpack(args))
                    elseif targetRemote:IsA("RemoteFunction") then
                        targetRemote:InvokeServer(unpack(args))
                    end
                end)
                task.wait(0.1) -- เธฃเธฐเธขเธฐเน€เธงเธฅเธฒเธงเธ Loop เธฃเธฑเธ Remote (เธเธฃเธฑเธเนเธ”เน)
            end
        end)
    else
        remoteLoopButton.Text = "Loop Remote: [ OFF ]"
        remoteLoopButton.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
    end
end

local function startMainUIProcess()
    keyFrame:Destroy()
    
    -- Loading Screen Logic
    local loadingFrame = Instance.new("Frame")
    loadingFrame.Name = "LoadingFrame"
    loadingFrame.Size = UDim2.new(1, 0, 1, 0)
    loadingFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
    loadingFrame.ZIndex = 10
    loadingFrame.Parent = screenGui

    local loadingTitle = Instance.new("TextLabel")
    loadingTitle.Size = UDim2.new(1, 0, 0, 40)
    loadingTitle.Position = UDim2.new(0, 0, 0.4, -40)
    loadingTitle.BackgroundTransparency = 1
    loadingTitle.Text = "Loading Beta System..."
    loadingTitle.TextColor3 = Color3.fromRGB(255, 215, 0)
    loadingTitle.TextSize = 22
    loadingTitle.Font = Enum.Font.SourceSansBold
    loadingTitle.ZIndex = 10
    loadingTitle.Parent = loadingFrame

    local barBackground = Instance.new("Frame")
    barBackground.Size = UDim2.new(0, 300, 0, 12)
    barBackground.Position = UDim2.new(0.5, -150, 0.4, 20)
    barBackground.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
    barBackground.ZIndex = 10
    barBackground.Parent = loadingFrame

    local barBgCorner = Instance.new("UICorner")
    barBgCorner.CornerRadius = UDim.new(0, 6)
    barBgCorner.Parent = barBackground

    local progressBar = Instance.new("Frame")
    progressBar.Size = UDim2.new(0, 0, 1, 0)
    progressBar.BackgroundColor3 = Color3.fromRGB(255, 215, 0)
    progressBar.ZIndex = 10
    progressBar.Parent = barBackground

    local progressBarCorner = Instance.new("UICorner")
    progressBarCorner.CornerRadius = UDim.new(0, 6)
    progressBarCorner.Parent = progressBar

    local percentLabel = Instance.new("TextLabel")
    percentLabel.Size = UDim2.new(1, 0, 0, 25)
    percentLabel.Position = UDim2.new(0, 0, 0.4, 40)
    percentLabel.BackgroundTransparency = 1
    percentLabel.Text = "0%"
    percentLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
    percentLabel.TextSize = 14
    percentLabel.Font = Enum.Font.SourceSans
    percentLabel.ZIndex = 10
    percentLabel.Parent = loadingFrame

    task.spawn(function()
        local totalTime = 4
        local startTime = os.clock()
        while (os.clock() - startTime) < totalTime do
            local elapsed = os.clock() - startTime
            local progress = math.clamp(elapsed / totalTime, 0, 1)
            progressBar.Size = UDim2.new(progress, 0, 1, 0)
            percentLabel.Text = math.floor(progress * 100) .. "%"
            task.wait()
        end
        progressBar.Size = UDim2.new(1, 0, 1, 0)
        percentLabel.Text = "100%"
        loadingTitle.Text = "Access Granted!"
        task.wait(0.5)

        local tweenInfo = TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        for _, child in ipairs(loadingFrame:GetDescendants()) do
            if child:IsA("Frame") then
                TweenService:Create(child, tweenInfo, {BackgroundTransparency = 1}):Play()
            elseif child:IsA("TextLabel") then
                TweenService:Create(child, tweenInfo, {TextTransparency = 1}):Play()
            end
        end
        local fadeFrame = TweenService:Create(loadingFrame, tweenInfo, {BackgroundTransparency = 1})
        fadeFrame:Play()
        fadeFrame.Completed:Connect(function()
            loadingFrame:Destroy()
            mainFrame.Visible = true
        end)
    end)
end

