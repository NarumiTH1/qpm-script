local function isCharacter(object)
	for _,player in ipairs(Players:GetPlayers()) do
		if player.Character and object:IsDescendantOf(player.Character) then
			return true
		end
	end
	return false
end

local function makeEffectTiny(obj)
	if not isCharacter(obj) then
		if obj:IsA("ParticleEmitter") then
			obj.Size = NumberSequence.new(0.001)
		elseif obj:IsA("Trail") then
			obj.WidthScale = NumberSequence.new(0.001)
		elseif obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") then
			obj.Size = 0.001
		elseif obj:IsA("Beam") then
			obj.Width0 = 0.001
			obj.Width1 = 0.001
		elseif obj:IsA("Light") then
			obj.Range = 0.001
		end
	end
end

local function toggleShrinkEffects()
	shrinkEffectsEnabled = not shrinkEffectsEnabled
	if shrinkEffectsEnabled then
		shrinkEffectButton.Text = "Shrink All Effects: [ ON ]"
		shrinkEffectButton.BackgroundColor3 = Color3.fromRGB(50,180,80)
		
		for _,obj in ipairs(workspace:GetDescendants()) do
			makeEffectTiny(obj)
		end
		shrinkConnection = workspace.DescendantAdded:Connect(function(obj)
			if shrinkEffectsEnabled then
				task.defer(function() makeEffectTiny(obj) end)
			end
		end)
	else
		shrinkEffectButton.Text = "Shrink All Effects: [ OFF ]"
		shrinkEffectButton.BackgroundColor3 = Color3.fromRGB(180,50,50)
		if shrinkConnection then
			shrinkConnection:Disconnect()
			shrinkConnection = nil
		end
	end
end

local function applyHighlightAndName(player)
	if not player or player==localPlayer then return end
	local char=player.Character
	if not char then return end
	local head=char:WaitForChild("Head",5)
	if not head then return end

	if not char:FindFirstChild("PlayerBlueHighlightESP") then
		local hl=Instance.new("Highlight")
		hl.Name="PlayerBlueHighlightESP"
		hl.FillColor=Color3.fromRGB(0,170,255)
		hl.FillTransparency=0.4
		hl.OutlineColor=Color3.fromRGB(255,255,255)
		hl.OutlineTransparency=0
		hl.Adornee=char
		hl.Parent=char
	end

	if not head:FindFirstChild("PlayerNameTagESP") then
		local bb=Instance.new("BillboardGui")
		bb.Name="PlayerNameTagESP"
		bb.Adornee=head
		bb.Size=UDim2.new(0,150,0,30)
		bb.StudsOffset=Vector3.new(0,2.5,0)
		bb.AlwaysOnTop=true
		bb.Parent=head

		local lbl=Instance.new("TextLabel")
		lbl.Size=UDim2.new(1,0,1,0)
		lbl.BackgroundTransparency=1
		lbl.Text=player.DisplayName.." (@"..player.Name..")"
		lbl.TextColor3=Color3.fromRGB(0,220,255)
		lbl.TextStrokeTransparency=0.2
		lbl.TextStrokeColor3=Color3.fromRGB(0,0,0)
		lbl.TextSize=13
		lbl.Font=Enum.Font.SourceSansBold
		lbl.Parent=bb
	end
end

local function removeHighlightAndName(player)
	if not player or not player.Character then return end
	local char=player.Character
	local hl=char:FindFirstChild("PlayerBlueHighlightESP")
	if hl then hl:Destroy() end
	local head=char:FindFirstChild("Head")
	if head then
		local tag=head:FindFirstChild("PlayerNameTagESP")
		if tag then tag:Destroy() end
	end
end

local function setupPlayerESP(player)
	if player==localPlayer then return end
	if player.Character then applyHighlightAndName(player) end
	local conn=player.CharacterAdded:Connect(function(char)
		if espEnabled then
			char:WaitForChild("HumanoidRootPart",5)
			applyHighlightAndName(player)
		end
	end)
	table.insert(espConnections,conn)
end

local function togglePlayerESP()
	espEnabled=not espEnabled
	if espEnabled then
		espButton.Text="Blue Highlight & Name ESP: [ ON ]"
		espButton.BackgroundColor3=Color3.fromRGB(50,180,80)
		for _,p in ipairs(Players:GetPlayers()) do setupPlayerESP(p) end
		local pAdded=Players.PlayerAdded:Connect(function(p) setupPlayerESP(p) end)
		table.insert(espConnections,pAdded)
	else
		espButton.Text="Blue Highlight & Name ESP: [ OFF ]"
		espButton.BackgroundColor3=Color3.fromRGB(180,50,50)
		for _,conn in ipairs(espConnections) do conn:Disconnect() end
		espConnections={}
		for _,p in ipairs(Players:GetPlayers()) do removeHighlightAndName(p) end
	end
end

local function toggleClearFogLoop()
	clearFogLoopEnabled=not clearFogLoopEnabled
	if clearFogLoopEnabled then
		clearFogLoopButton.Text="Loop Clear Fog & Light: [ ON ]"
		clearFogLoopButton.BackgroundColor3=Color3.fromRGB(50,180,80)
		task.spawn(function()
			while clearFogLoopEnabled do
				for _,v in ipairs(Lighting:GetChildren()) do
					if v:IsA("PostEffect") or v:IsA("Atmosphere") or v:IsA("Clouds") then
						v:Destroy()
					end
				end
				Lighting.FogEnd=100000
				Lighting.GlobalShadows=false
				task.wait(0.5)
			end
		end)
	else
		clearFogLoopButton.Text="Loop Clear Fog & Light: [ OFF ]"
		clearFogLoopButton.BackgroundColor3=Color3.fromRGB(180,50,50)
	end
end

